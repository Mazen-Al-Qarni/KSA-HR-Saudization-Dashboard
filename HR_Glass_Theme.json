{
  "name": "HR Glass",
  "dataColors": ["#7CF3CF", "#FFB347", "#3FB894", "#8FA9A1", "#5B8CFF", "#F5C542", "#CFE6DF", "#B5CCC5"],
  "background": "#071A1F",
  "foreground": "#F2FBF8",
  "tableAccent": "#7CF3CF",
  "good": "#7CF3CF",
  "neutral": "#F5C542",
  "bad": "#FFB347",
  "maximum": "#7CF3CF",
  "center": "#3FB894",
  "minimum": "#0E3A33",
  "textClasses": {
    "callout": { "fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#CFE6DF" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": false, "transparency": 100 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "subTitle": [{ "fontColor": { "solid": { "color": "#B5CCC5" } }, "fontSize": 10 }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#CFE6DF" } }, "titleColor": { "solid": { "color": "#CFE6DF" } }, "gridlineColor": { "solid": { "color": "#2A4A47" } }, "showAxisTitle": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#B5CCC5" } }, "titleColor": { "solid": { "color": "#B5CCC5" } }, "gridlineColor": { "solid": { "color": "#2A4A47" } }, "showAxisTitle": false }],
        "legend": [{ "labelColor": { "solid": { "color": "#CFE6DF" } } }],
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } } }],
        "visualHeader": [{ "background": { "solid": { "color": "#0B2A2E" } }, "foreground": { "solid": { "color": "#CFE6DF" } }, "border": { "solid": { "color": "#0B2A2E" } } }]
      }
    },
    "page": {
      "*": {
        "outspace": [{ "color": { "solid": { "color": "#071A1F" } }, "transparency": 0 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#B5CCC5" } }, "fontSize": 10 }],
        "items": [{ "fontColor": { "solid": { "color": "#F2FBF8" } }, "background": { "solid": { "color": "#0E2E31" } } }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#B5CCC5" } }, "backColor": { "solid": { "color": "#0B2A2E" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#F2FBF8" } }, "backColorPrimary": { "solid": { "color": "#0B2A2E" } }, "fontColorSecondary": { "solid": { "color": "#F2FBF8" } }, "backColorSecondary": { "solid": { "color": "#0B2A2E" } } }]
      }
    }
  }
}
